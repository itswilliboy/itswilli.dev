---
import Friends from "../components/Friends.vue"
import NowPlaying from "../components/NowPlaying.vue"
import Project from "../components/Project.astro"
import Tooltip from "../components/Tooltip.vue"
import Base from "../layouts/Base.astro"
import type { Friend, Project as ProjectType } from "../types"

const socials = [
  {
    href: "https://github.com/itswilliboy",
    name: "github"
  },
  {
    href: "https://discord.com/users/263602820496883712",
    name: "discord"
  }
]

const projects: ProjectType[] = [
  {
    name: "Harmony",
    description: "Harmony is a multipurpose Discord Bot built in Python using discord.py",
    href: "https://github.com/itswilliboy/Harmony",
    colour: "#3573A6",
    icon: "skill-icons:python-dark"
  },
  {
    name: "itswilli.vue",
    description: "This site. Built with Astro and Vue using TailwindCSS",
    href: "https://github.com/itswilliboy/itswilli.dev",
    colour: "#BC52EE",
    icon: "skill-icons:astro"
  },
  {
    name: "meteorite",
    description: "A small image host written in Go, available at i.itswilli.dev",
    href: "https://github.com/itswilliboy/meteorite",
    colour: "#00ADD8",
    icon: "skill-icons:golang"
  }
]

const friends: Friend[] = [
  {
    name: "Faaz",
    href: "https://faaz.dev",
    githubID: 70286349
  },
  {
    name: "Dep",
    href: "https://deppie-dev.vercel.app",
    githubID: 70801324
  },
  {
    name: "Vahin",
    href: "https://vahin.dev",
    githubID: 66386770
  },
  {
    name: "Leo",
    href: "https://leo.might-be.gay",
    githubID: 13399568
  }
]
---

<Base>
  <div class="flex w-full flex-1 flex-col items-center justify-center px-4 py-12 font-semibold text-white">
    <div class="flex flex-col">
      <div class="flex flex-col items-center justify-center md:flex-row md:gap-0">
        <div class="relative flex flex-col items-center justify-center md:items-start">
          <img
            src="/milo.jpg"
            alt=""
            aria-hidden="true"
            class="pointer-events-none absolute top-1/2 left-1/2 h-56 w-72 -translate-x-1/2 -translate-y-1/2 object-cover opacity-20 md:hidden"
            style="
              -webkit-mask-image:
                linear-gradient(to right, transparent 0%, black 38%, black 62%, transparent 100%),
                linear-gradient(to bottom, transparent 0%, black 38%, black 62%, transparent 100%);
              mask-image:
                linear-gradient(to right, transparent 0%, black 38%, black 62%, transparent 100%),
                linear-gradient(to bottom, transparent 0%, black 38%, black 62%, transparent 100%);
              -webkit-mask-composite: source-in;
              mask-composite: intersect;
            "
          />

          <h2 class="text-muted relative mb-3 text-lg md:mb-0 md:text-2xl">Hello, I am</h2>
          <h1 class="text-primary relative text-[6rem] leading-[.7] font-bold md:text-[10rem]">Willi</h1>

          <div class="relative flex items-center gap-1 pt-6 text-sm md:pl-4">
            {
              socials.map((social, index) => (
                <>
                  {index > 0 && <span class="text-faint">&centerdot;</span>}
                  <a
                    href={social.href}
                    target="_blank"
                    class="text-primary/80 hover:text-primary font-normal transition-colors">
                    {social.name}
                  </a>
                </>
              ))
            }
          </div>
        </div>

        <div class="hidden md:block">
          <Tooltip client:load text="Yes, it's my cat..." focusable>
            <img
              class="ml-6 h-64 w-64 rounded-lg object-cover"
              src="/milo.jpg"
              alt="Milo, a ragdoll cat, chewing on a houseplant"
            />
          </Tooltip>
        </div>
      </div>

      <NowPlaying client:load class="mx-auto mt-8 block w-72 md:absolute md:top-24 md:right-4 md:mx-0 md:mt-0" />

      <div class="mt-8 flex flex-col items-center justify-center gap-4 lg:flex-row">
        {projects.map(project => <Project project={project} />)}
      </div>

      <Friends client:load friends={friends} class="mt-8 self-center md:absolute md:top-4 md:right-4 md:mt-0" />
    </div>
  </div>
</Base>
