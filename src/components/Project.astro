---
import { Icon } from "astro-icon/components"
import { getLanguageColour, getLanguageIcon } from "../lib/languageIcons"
import type { Repo } from "../types"

interface Props {
  repo: Repo
}

const { repo } = Astro.props
const icon = getLanguageIcon(repo.primaryLanguage?.name)
const colour = getLanguageColour(repo.primaryLanguage?.name, repo.primaryLanguage?.color)
---

<a
  class="group bg-surface border-border/60 hover:bg-surface-raised focus-visible:outline-primary relative min-h-28 w-72 overflow-hidden rounded-lg border pb-3 shadow-lg shadow-black/20 transition-[background-color,box-shadow,transform] duration-200 will-change-transform hover:-translate-y-0.5 hover:shadow-xl hover:shadow-black/40 focus-visible:outline-2"
  href={repo.url}
  target="_blank">
  <div class="flex items-center justify-between px-3 pt-3">
    <div class="flex items-center justify-between gap-2">
      <Icon name={icon} size="1.5em" />
      <h3 class="text-lg">{repo.name}</h3>
      <div class="inline-flex items-center gap-0.5 text-sm font-medium opacity-50">
        <Icon name="lucide:star" class="translate-y-px" />
        <p>{repo.stargazerCount}</p>
      </div>
    </div>
    <img src="/github.svg" alt="GitHub" class="w-5 opacity-30 transition-opacity group-hover:opacity-60" />
  </div>
  <div class="text-muted mt-1 px-3 text-sm">{repo.description}</div>
  <div class="absolute bottom-0 h-1 w-full transition-all group-hover:brightness-125" style={`background-color: ${colour}`}>
  </div>
</a>
